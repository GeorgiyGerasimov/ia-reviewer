{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode — Vite resolves modules, TS just type-checks. */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness — match the rigor we want on the backend side. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* Vitest + jest-dom provide the global `expect` augmentation. */
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    /* `@/*` → `src/*` matches the canonical shadcn / Vite convention.
       Components copied in via `npx shadcn add …` use this alias
       (e.g. `import { cn } from "@/lib/utils"`); the same alias
       must be configured in vite.config.ts so the bundler resolves
       it identically. */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
