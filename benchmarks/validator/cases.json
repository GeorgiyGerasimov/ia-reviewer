{
  "$schema": "Each case is one validator input. The runner loads `diff_file` from `fixtures/` when present; otherwise uses `diff_inline`. `mode` is 'pr' (default) or 'repo'. For repo-mode, `repo_files_count` synthesises a list of placeholder RepoFiles to exercise the count-based prefilter.",
  "cases": [
    {
      "name": "empty-diff-whitespace",
      "category": "pure-code/empty_diff",
      "mode": "pr",
      "diff_inline": "   \n\n  \t\n",
      "files_changed": [],
      "expected": {"accepted": false, "category": "empty_diff"}
    },
    {
      "name": "empty-diff-only-headers",
      "category": "pure-code/empty_diff",
      "mode": "pr",
      "diff_inline": "diff --git a/foo b/foo\n--- a/foo\n+++ b/foo\n",
      "files_changed": ["foo"],
      "expected": {"accepted": false, "category": "empty_diff"}
    },
    {
      "name": "docs-only-readme",
      "category": "pure-code/docs_only",
      "mode": "pr",
      "diff_inline": "diff --git a/README.md b/README.md\n@@ -1,1 +1,2 @@\n # Project\n+New tagline here.\n",
      "files_changed": ["README.md"],
      "expected": {"accepted": false, "category": "docs_only"}
    },
    {
      "name": "docs-only-multiple-md",
      "category": "pure-code/docs_only",
      "mode": "pr",
      "diff_inline": "diff --git a/docs/api.md b/docs/api.md\n@@ -1,1 +1,2 @@\n # API\n+Update.\ndiff --git a/CHANGELOG b/CHANGELOG\n@@ -1,1 +1,2 @@\n v1\n+v2 released\n",
      "files_changed": ["docs/api.md", "CHANGELOG"],
      "expected": {"accepted": false, "category": "docs_only"}
    },
    {
      "name": "autogenerated-lockfile",
      "category": "pure-code/autogenerated",
      "mode": "pr",
      "diff_inline": "diff --git a/package-lock.json b/package-lock.json\n@@ -100,3 +100,3 @@\n-    \"lodash\": \"4.17.20\"\n+    \"lodash\": \"4.17.21\"\n",
      "files_changed": ["package-lock.json"],
      "expected": {"accepted": false, "category": "autogenerated"}
    },
    {
      "name": "autogenerated-marker",
      "category": "pure-code/autogenerated",
      "mode": "pr",
      "diff_file": "autogen_marker.diff",
      "files_changed": ["src/proto/user_pb.py"],
      "expected": {"accepted": false, "category": "autogenerated"}
    },
    {
      "name": "accepted-sqli-fix",
      "category": "llm-judge/accepted",
      "mode": "pr",
      "diff_file": "sqli_fix.diff",
      "files_changed": ["src/auth/login.py", "tests/test_login.py"],
      "expected": {"accepted": true, "category": "accepted"}
    },
    {
      "name": "accepted-refactor",
      "category": "llm-judge/accepted",
      "mode": "pr",
      "diff_file": "refactor_extract_method.diff",
      "files_changed": ["src/orders/processor.py"],
      "expected": {"accepted": true, "category": "accepted"}
    },
    {
      "name": "accepted-new-endpoint",
      "category": "llm-judge/accepted",
      "mode": "pr",
      "diff_file": "add_endpoint.diff",
      "files_changed": ["src/api/users.py", "tests/test_users_api.py"],
      "expected": {"accepted": true, "category": "accepted"}
    },
    {
      "name": "trolling-remove-payment",
      "category": "llm-judge/trolling",
      "mode": "pr",
      "diff_file": "trolling_remove_all.diff",
      "files_changed": ["src/payment/processor.py", "tests/test_payment.py"],
      "expected": {"accepted": false, "category": "trolling"}
    },
    {
      "name": "trolling-emoji-spam",
      "category": "llm-judge/trolling",
      "mode": "pr",
      "diff_file": "trolling_emoji_spam.diff",
      "files_changed": ["src/main.py"],
      "expected": {"accepted": false, "category": "trolling"}
    },
    {
      "name": "empty-repo",
      "category": "pure-code/empty_repo",
      "mode": "repo",
      "repo_files_count": 0,
      "expected": {"accepted": false, "category": "empty_repo"}
    },
    {
      "name": "oversized-repo",
      "category": "pure-code/oversized_repo",
      "mode": "repo",
      "repo_files_count": 5001,
      "expected": {"accepted": false, "category": "oversized_repo"}
    },
    {
      "name": "accepted-repo-normal-size",
      "category": "pure-code/accepted-repo",
      "mode": "repo",
      "repo_files_count": 50,
      "expected": {"accepted": true, "category": "accepted"}
    }
  ]
}
